{"critical_fields": [], "document_id": "headings-manual", "family": "multilevel_headings", "file": "documents/headings-manual.pdf", "height": 792.0, "license": "synthetic-generated-cc0", "page": 1, "page_count": 2, "regions": [{"bbox": [72, 60, 249.1, 81], "expected_text": "Chapter 1: Installation", "kind": "heading", "reading_order": 0, "region_id": "r1"}, {"bbox": [72, 96, 235.1, 113], "expected_text": "1.1 System Requirements", "kind": "heading", "reading_order": 1, "region_id": "r2"}, {"bbox": [72, 126, 547.2, 154.0], "expected_text": "The agent requires Python 3.11 or newer and two gigabytes of free memory for the extraction workers.", "kind": "text", "reading_order": 2, "region_id": "r3"}, {"bbox": [72, 190, 201.8, 204], "expected_text": "1.1.1 Supported Platforms", "kind": "heading", "reading_order": 3, "region_id": "r4"}, {"bbox": [72, 216, 547.2, 244.0], "expected_text": "Linux and macOS are fully supported. Windows deployments use the provided container images exclusively.", "kind": "text", "reading_order": 4, "region_id": "r5"}, {"bbox": [72, 280, 166.6, 297], "expected_text": "1.2 Quick Start", "kind": "heading", "reading_order": 5, "region_id": "r6"}, {"bbox": [72, 310, 547.2, 338.0], "expected_text": "Install the package, export the API key, then run the smoke command to verify the local pipeline end to end.", "kind": "text", "reading_order": 6, "region_id": "r7"}], "source_hash": "sha256:3d04bb60b15ebbafaacf85df8ccd114d1d0082fe01c127a76666e1a57fadf4c8", "tables": [], "width": 612.0}
