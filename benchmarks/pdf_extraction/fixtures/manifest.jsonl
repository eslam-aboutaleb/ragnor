{"critical_fields": [], "document_id": "plain-digital-report", "family": "plain_digital", "file": "documents/plain-digital-report.pdf", "height": 792.0, "license": "synthetic-generated-cc0", "page": 1, "page_count": 2, "regions": [{"bbox": [72, 72, 275.0, 91], "expected_text": "Quarterly Operations Report", "kind": "heading", "reading_order": 0, "region_id": "r1"}, {"bbox": [72, 110, 547.2, 153.0], "expected_text": "Revenue grew twelve percent year over year while operating costs stayed flat. The logistics division shipped 18420 orders across nine regional warehouses.", "kind": "text", "reading_order": 1, "region_id": "r2"}, {"bbox": [72, 200, 547.2, 243.0], "expected_text": "Customer satisfaction averaged 4.6 out of 5 across surveyed accounts. Renewal rates improved in every segment except retail partnerships.", "kind": "text", "reading_order": 2, "region_id": "r3"}], "source_hash": "sha256:705eba4f657714916bb1a580bf083820f78f82769b61337c69dbd2b38ca8d063", "tables": [], "width": 612.0}
{"critical_fields": [], "document_id": "plain-digital-report", "family": "plain_digital", "file": "documents/plain-digital-report.pdf", "height": 792.0, "license": "synthetic-generated-cc0", "page": 2, "page_count": 2, "regions": [{"bbox": [72, 72, 243.0, 91], "expected_text": "Outlook and Hiring Plan", "kind": "heading", "reading_order": 0, "region_id": "r1"}, {"bbox": [72, 110, 547.2, 153.0], "expected_text": "The company plans to hire fourteen engineers and six analysts next quarter. Capital expenditure remains focused on warehouse automation projects.", "kind": "text", "reading_order": 1, "region_id": "r2"}], "source_hash": "sha256:705eba4f657714916bb1a580bf083820f78f82769b61337c69dbd2b38ca8d063", "tables": [], "width": 612.0}
{"critical_fields": [], "document_id": "two-column-newsletter", "family": "two_column", "file": "documents/two-column-newsletter.pdf", "height": 792.0, "license": "synthetic-generated-cc0", "page": 1, "page_count": 2, "regions": [{"bbox": [72, 60, 271.6, 77], "expected_text": "Community Newsletter Issue 14", "kind": "heading", "reading_order": 0, "region_id": "r1"}, {"bbox": [72, 96, 316.8, 169.0], "expected_text": "The river cleanup drew eighty volunteers last Saturday and filled forty five bags with debris. Organizers thanked the boating club for ferry support.", "kind": "text", "reading_order": 1, "region_id": "r2"}, {"bbox": [72, 330, 316.8, 403.0], "expected_text": "Library hours extend to nine in the evening on weekdays starting next month. Weekend hours remain unchanged through the winter season.", "kind": "text", "reading_order": 2, "region_id": "r3"}, {"bbox": [330, 96, 574.8, 169.0], "expected_text": "The volunteer schedule for the park cleanup now includes a weekday shift. Sign up through the community portal before Thursday evening.", "kind": "text", "reading_order": 3, "region_id": "r4"}, {"bbox": [330, 330, 574.8, 403.0], "expected_text": "Farmers market vendors report record attendance this season. Stall applications for the spring market open on the first Monday of December.", "kind": "text", "reading_order": 4, "region_id": "r5"}], "source_hash": "sha256:fb1f18878ccee0db5e419087d0521f25ad5892760f14cf58db90cc4e8f866255", "tables": [], "width": 612.0}
{"critical_fields": [], "document_id": "two-column-newsletter", "family": "two_column", "file": "documents/two-column-newsletter.pdf", "height": 792.0, "license": "synthetic-generated-cc0", "page": 2, "page_count": 2, "regions": [{"bbox": [72, 60, 219.5, 77], "expected_text": "Classifieds and Notices", "kind": "heading", "reading_order": 0, "region_id": "r1"}, {"bbox": [72, 96, 316.8, 169.0], "expected_text": "Found: a silver bracelet near the ferry terminal. Describe the engraving to claim it at the harbor office during opening hours.", "kind": "text", "reading_order": 1, "region_id": "r2"}, {"bbox": [330, 96, 574.8, 154.0], "expected_text": "Lost: a black umbrella with a wooden handle, last seen at the library reading room. A small reward is offered for its return.", "kind": "text", "reading_order": 2, "region_id": "r3"}], "source_hash": "sha256:fb1f18878ccee0db5e419087d0521f25ad5892760f14cf58db90cc4e8f866255", "tables": [], "width": 612.0}
{"critical_fields": [], "document_id": "three-column-brochure", "family": "three_column", "file": "documents/three-column-brochure.pdf", "height": 792.0, "license": "synthetic-generated-cc0", "page": 1, "page_count": 2, "regions": [{"bbox": [50, 80, 208.4, 183.0], "expected_text": "Starter tier includes ten thousand requests per month, community support and a single shared workspace for small evaluation projects.", "kind": "text", "reading_order": 0, "region_id": "r1"}, {"bbox": [226, 80, 384.4, 183.0], "expected_text": "Growth tier adds priority queues, five workspaces, audit logs and ninety day retention for all extraction and retrieval telemetry.", "kind": "text", "reading_order": 1, "region_id": "r2"}, {"bbox": [402, 80, 560.4, 183.0], "expected_text": "Enterprise tier provides dedicated clusters, custom retention, private connectivity and a named support engineer for onboarding.", "kind": "text", "reading_order": 2, "region_id": "r3"}], "source_hash": "sha256:1e3dfc86b120940e1a37e05a2e1809a5de6bdf20297ebd0b9c0a7eecf45acc53", "tables": [], "width": 612.0}
{"critical_fields": [], "document_id": "three-column-brochure", "family": "three_column", "file": "documents/three-column-brochure.pdf", "height": 792.0, "license": "synthetic-generated-cc0", "page": 2, "page_count": 2, "regions": [{"bbox": [50, 60, 129.8, 77], "expected_text": "Pricing Tiers", "kind": "heading", "reading_order": 0, "region_id": "r1"}, {"bbox": [50, 96, 208.4, 199.0], "expected_text": "Starter is free forever and requires no credit card. Usage beyond the monthly allowance is rejected with a clear rate limit response.", "kind": "text", "reading_order": 1, "region_id": "r2"}, {"bbox": [226, 96, 384.4, 199.0], "expected_text": "Growth is billed per workspace monthly. Annual prepay discounts apply automatically at checkout for qualifying teams.", "kind": "text", "reading_order": 2, "region_id": "r3"}, {"bbox": [402, 96, 560.4, 199.0], "expected_text": "Enterprise pricing is quoted per contract. Contact sales with expected volume and compliance requirements for a written estimate.", "kind": "text", "reading_order": 3, "region_id": "r4"}], "source_hash": "sha256:1e3dfc86b120940e1a37e05a2e1809a5de6bdf20297ebd0b9c0a7eecf45acc53", "tables": [], "width": 612.0}
